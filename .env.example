# Google Sheet ID (from the sheet URL: /spreadsheets/d/<THIS PART>/edit)
GOOGLE_SHEET_ID=your-spreadsheet-id-here

# Service account credentials (from the JSON key file downloaded in Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Keep the \n escape sequences as-is (don't turn them into real newlines)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
